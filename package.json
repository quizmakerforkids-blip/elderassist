{
  "name": "elderassist-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "train": "node server/ai/train.cjs",
    "server": "node server/index.js",
    "dev": "vite --mode caregiver",
    "dev:caregiver": "vite --mode caregiver",
    "dev:cared": "vite --mode cared",
    "dev:all": "concurrently \"npm run server\" \"npm run dev:caregiver\" \"npm run dev:cared\"",
    "build:caregiver": "vite build --mode caregiver",
    "build:cared": "vite build --mode cared",
    "build": "npm run build:caregiver && npm run build:cared",
    "start": "node server/index.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.6.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
